{
  "name": "kasupport-app",
  "version": "0.1.0",
  "private": true,
  "description": "Kasupport — app de escritorio tipo Slack (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_DEV=1 electron .",
    "build:renderer": "cd renderer && npm run build",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:renderer && electron-builder --mac --win",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:renderer && electron-builder --mac",
    "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:renderer && electron-builder --win"
  },
  "build": {
    "appId": "com.kasupport.app",
    "productName": "Kasupport",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Kasupport usa la cámara para llamadas y reuniones cuando tú la activas.",
        "NSMicrophoneUsageDescription": "Kasupport usa el micrófono para llamadas y reuniones cuando tú lo activas.",
        "NSScreenCaptureUsageDescription": "Kasupport comparte tu pantalla únicamente cuando tú lo solicitas."
      },
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },

    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
