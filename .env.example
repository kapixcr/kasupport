# Backend
PORT=4100
NODE_ENV=development
DATABASE_URL=postgres://kasupport:change-me@localhost:5432/kasupport
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:7100
PUBLIC_MEET_URL=http://localhost:7100
ALLOW_PUBLIC_REGISTRATION=true

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_URL=https://api.example.com/api/meetings/livekit/webhook

# Grabaciones privadas: AWS S3, Cloudflare R2 o MinIO
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEETING_RECORDING_ENABLED=true
MEETING_RECORDING_PREFIX=recordings
MEETING_MAX_PARTICIPANTS=15
MEETING_GUEST_TOKEN_TTL_MINUTES=240

# Renderer (copiar lo necesario a app/renderer/.env.local)
VITE_API_URL=http://localhost:4100
