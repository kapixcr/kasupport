# Backend
PORT=4100
NODE_ENV=development
DATABASE_URL=postgres://kasupport:change-me@localhost:5432/kasupport
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:7100
PUBLIC_MEET_URL=http://localhost:7100
ALLOW_PUBLIC_REGISTRATION=true

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_URL=https://api.example.com/api/meetings/livekit/webhook

# Grabaciones privadas: AWS S3, Cloudflare R2 o MinIO
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEETING_RECORDING_ENABLED=true
MEETING_RECORDING_PREFIX=recordings
MEETING_MAX_PARTICIPANTS=15
MEETING_GUEST_TOKEN_TTL_MINUTES=240

# Integración Correo Google Workspace (IMAP + SMTP)
# Para soporte@kapix.co.cr generar Contraseña de Aplicación en myaccount.google.com/apppasswords
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=true
EMAIL_IMAP_USER=soporte@kapix.co.cr
EMAIL_IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_POLL_INTERVAL_SECONDS=30

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=soporte@kapix.co.cr
EMAIL_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Kasupport Soporte <soporte@kapix.co.cr>"
EMAIL_AUTO_REPLY=true


# Renderer (copiar lo necesario a app/renderer/.env.local)
VITE_API_URL=http://localhost:4100
